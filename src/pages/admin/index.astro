---
/**
 * ADMIN PANEL — URL + server auth only. Never linked from a public page.
 *
 * Three things keep it that way, and none of them rely on remembering:
 *   - No component renders a link here. The Footer has no admin markup at
 *     all, and the nav is built from config, which has no admin entry.
 *   - astro.config excludes /admin from the sitemap.
 *   - public/_headers sends X-Robots-Tag noindex,nofollow and no-store for
 *     /admin/*, and robots.txt disallows it.
 *
 * The page itself is a shell. It renders NO product data server-side —
 * everything is fetched with a Bearer token after login, so an unauthorised
 * request gets an empty form, not a leaked inventory list.
 *
 * No React here on purpose. The customer-facing quiz is worth an island;
 * an internal CRUD panel is not worth shipping a framework for.
 */
import { site, enabledCategories } from '../../config';

// Belt and braces alongside public/_headers.
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Inventory admin — {site.identity.name}</title>
    <link rel="icon" href={site.brand.logos.favicon} />
    <style define:vars={{
      primary: site.brand.colors.primary,
      deep: site.brand.colors.deep,
      night: site.brand.colors.night,
      accent: site.brand.colors.accent,
      urgent: site.brand.colors.urgent,
      ink: site.brand.colors.ink,
      inkMuted: site.brand.colors.inkMuted,
      surfaceAlt: site.brand.colors.surfaceAlt,
    }}>
      :root { color-scheme: light; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        min-height: 100vh;
        font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
        background: #f3f4f6;
        color: var(--ink);
        line-height: 1.45;
      }
      header {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: 56px;
        padding: 10px 20px;
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
      }
      header .brand { min-width: 0; }
      header .kicker {
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--inkMuted);
      }
      header h1 {
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -.01em;
        color: var(--night);
      }
      header .who {
        font-size: .8rem;
        color: var(--inkMuted);
        text-align: right;
      }
      main { max-width: 1120px; margin: 0 auto; padding: 28px 20px 72px; }
      .card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px 22px 22px;
        margin-bottom: 16px;
        box-shadow: 0 1px 2px rgb(15 23 42 / .04);
      }
      .card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
      }
      .card-head h2, h2 {
        font-size: .95rem;
        font-weight: 600;
        letter-spacing: -.01em;
        color: var(--night);
        margin-bottom: 0;
      }
      h2 { margin-bottom: 14px; }
      .block {
        border: 0;
        margin: 0 0 22px;
        padding: 0 0 22px;
        border-bottom: 1px solid #eef0f3;
      }
      .block:last-of-type { margin-bottom: 0; padding-bottom: 0; border-bottom: 0; }
      .block legend {
        width: 100%;
        margin-bottom: 12px;
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--inkMuted);
      }
      label {
        display: block;
        font-size: .78rem;
        font-weight: 600;
        color: #3f4b5f;
        margin: 0 0 6px;
      }
      input, select, textarea {
        width: 100%;
        padding: 9px 11px;
        font: inherit;
        font-size: .95rem;
        border: 1px solid #d5dae3;
        border-radius: 8px;
        background: #fff;
        color: var(--ink);
      }
      input:focus, select:focus, textarea:focus {
        outline: 2px solid color-mix(in srgb, var(--primary) 35%, #93c5fd);
        outline-offset: 1px;
        border-color: color-mix(in srgb, var(--primary) 45%, #94a3b8);
      }
      textarea { resize: vertical; min-height: 72px; }
      button {
        font: inherit;
        font-weight: 600;
        cursor: pointer;
        border: none;
        border-radius: 8px;
        padding: 9px 14px;
        min-height: 40px;
      }
      .primary { background: var(--night); color: #fff; }
      .primary:hover { filter: brightness(1.08); }
      .ghost { background: #fff; color: var(--deep); border: 1px solid #d5dae3; }
      .ghost:hover { background: #f8fafc; }
      .danger { background: #fff; color: var(--urgent); border: 1px solid #f0c9c7; }
      .danger:hover { background: #fef6f5; }
      .btn-sm { padding: 5px 10px; min-height: 0; font-size: .78rem; font-weight: 600; }
      .row { display: grid; gap: 12px; grid-template-columns: 1fr; }
      @media (min-width: 700px) {
        .row.two { grid-template-columns: 1fr 1fr; }
        .row.three { grid-template-columns: 1fr 1fr 1fr; }
      }
      .table-wrap { overflow-x: auto; margin: 0 -6px; }
      table { width: 100%; border-collapse: collapse; font-size: .86rem; }
      th, td { text-align: left; padding: 11px 8px; border-bottom: 1px solid #eef0f3; vertical-align: middle; }
      th {
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: var(--inkMuted);
      }
      tbody tr:hover { background: #f8fafc; }
      .photo img, .photo-empty {
        display: block;
        width: 48px;
        height: 36px;
        border-radius: 6px;
        object-fit: cover;
        background: #eef1f5;
        border: 1px solid #e5e7eb;
      }
      .name { font-weight: 600; color: var(--night); }
      .meta { font-size: .72rem; color: var(--inkMuted); margin-top: 2px; }
      .meta.good { color: #17643d; }
      .meta.bad { color: #a3231b; }
      .status-cell select { min-width: 132px; padding: 6px 8px; font-size: .8rem; }
      .row-actions { display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; }
      .orphan { background: #fef4f3; color: #9a2b24; border: 1px solid #f3c7c3;
                padding: 10px 12px; border-radius: 8px; font-size: .82rem; margin-bottom: 12px; }
      .msg { padding: 10px 12px; border-radius: 8px; font-size: .84rem; margin-bottom: 14px; }
      .msg.err { background: #fef4f3; color: #9a2b24; }
      .msg.ok { background: #eef8f1; color: #17643d; }
      .hint { font-size: .75rem; color: var(--inkMuted); margin-top: 6px; }
      .hidden { display: none !important; }
      .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
      .login-wrap { max-width: 400px; margin: 72px auto; }
      .login-wrap .card { padding: 28px 28px 26px; }
      .login-wrap h2 { font-size: 1.15rem; margin-bottom: 6px; }
      .login-wrap .lead { font-size: .86rem; color: var(--inkMuted); margin-bottom: 18px; }
      .login-wrap .primary { width: 100%; }
      .check-row { display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; background: #f8fafc; }
      .check-row input { width: auto; margin-top: 2px; }
      .check-row label { margin: 0; font-size: .88rem; font-weight: 500; color: var(--ink); }
      .gallery-list { display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); margin: 10px 0 4px; }
      .gallery-item { position: relative; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; background: #f3f4f6; }
      .gallery-item img { display: block; width: 100%; height: 80px; object-fit: cover; }
      .gallery-item button { position: absolute; top: 6px; right: 6px; padding: 3px 7px; min-height: 0; font-size: .68rem; }
      .empty { color: var(--inkMuted); padding: 18px 8px; }
      .stack { margin-top: 12px; }
    </style>
  </head>

  <body>
    <header>
      <div class="brand">
        <div class="kicker">{site.identity.name}</div>
        <h1>Inventory</h1>
      </div>
      <div>
        <div class="who" id="headerMeta">Dealer desk</div>
        <button id="logout" class="ghost btn-sm hidden">Sign out</button>
      </div>
    </header>

    <main>
      <section id="login" class="login-wrap">
        <div class="card">
          <h2>Sign in</h2>
          <p class="lead">Use the website admin password from Launchpad.</p>
          <div id="loginMsg"></div>
          <form id="loginForm">
            <label for="password">Password</label>
            <input id="password" type="password" autocomplete="current-password" required />
            <div class="actions">
              <button class="primary" type="submit">Continue</button>
            </div>
          </form>
        </div>
      </section>

      <section id="panel" class="hidden">
        <div id="globalMsg"></div>

        <div class="card">
          <div class="card-head">
            <h2>Floor units</h2>
            <button type="button" class="ghost btn-sm" id="newProduct">Add product</button>
          </div>
          <div id="orphanNotice" class="orphan hidden"></div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th></th>
                  <th>Product</th>
                  <th>Category</th>
                  <th>Status</th>
                  <th>Price</th>
                  <th>Monthly</th>
                  <th>Qty</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="rows"><tr><td class="empty" colspan="8">Loading…</td></tr></tbody>
            </table>
          </div>
        </div>

        <div class="card" id="formCard">
          <h2 id="formTitle">Add a product</h2>
          <div id="formMsg"></div>
          <form id="productForm">
            <fieldset class="block">
              <legend>Product</legend>
              <div class="row two">
                <div>
                  <label for="inventory_name">Name</label>
                  <input id="inventory_name" required />
                </div>
                <div>
                  <label for="slug">URL slug</label>
                  <input id="slug" placeholder="Leave blank to generate from the name" />
                </div>
              </div>
              <div class="row three stack">
                <div>
                  <label for="category">Category</label>
                  <select id="category" required disabled={enabledCategories.length === 0}>
                    {enabledCategories.length === 0 ? (
                      <option value="">No product groups enabled</option>
                    ) : (
                      enabledCategories.map((c) => <option value={c.slug}>{c.label}</option>)
                    )}
                  </select>
                  <p class="hint">Only categories enabled in Launchpad Content.</p>
                </div>
                <div>
                  <label for="status">Status</label>
                  <select id="status">
                    <option value="draft">Draft (hidden)</option>
                    <option value="available">Available</option>
                    <option value="pending">Sale pending</option>
                    <option value="sold">Sold</option>
                    <option value="hidden">Hidden</option>
                  </select>
                </div>
                <div>
                  <label for="quantity">Quantity</label>
                  <input id="quantity" type="number" min="0" value="1" />
                </div>
              </div>
            </fieldset>

            <fieldset class="block">
              <legend>Pricing</legend>
              <div class="row three">
                <div><label for="price">Cash price ($)</label><input id="price" type="number" min="0" /></div>
                <div><label for="monthly_payment">Monthly ($)</label><input id="monthly_payment" type="number" min="0" /></div>
                <div><label for="sort_order">Sort order</label><input id="sort_order" type="number" value="0" /></div>
              </div>
            </fieldset>

            <fieldset class="block">
              <legend>Photos</legend>
              <div class="row two">
                <div>
                  <label for="imageFile">Main photo</label>
                  <input id="imageFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
                  <p class="hint" id="uploadHint">JPG, PNG, WEBP or GIF, up to 6 MB.</p>
                  <label for="primary_image">or photo URL</label>
                  <input id="primary_image" placeholder="https://… or /images/…" />
                </div>
                <div>
                  <label for="galleryFile">Gallery photo</label>
                  <input id="galleryFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
                  <p class="hint">Up to 20 extra views on the product page.</p>
                  <label for="gallery_images">or gallery URLs</label>
                  <textarea id="gallery_images" rows="3" placeholder="One URL per line"></textarea>
                </div>
              </div>
              <div id="galleryList" class="gallery-list"></div>
            </fieldset>

            <fieldset class="block">
              <legend>Listing</legend>
              <div class="check-row">
                <input id="featured" type="checkbox" />
                <label for="featured">Featured — show this unit first on inventory pages</label>
              </div>
              <div class="row two stack">
                <div><label for="promo_label">Badge</label><input id="promo_label" placeholder="LAST ONE" /></div>
                <div><label for="delivery_promise">Delivery promise</label><input id="delivery_promise" placeholder="Delivery in 2 weeks" /></div>
              </div>
            </fieldset>

            <fieldset class="block">
              <legend>Copy</legend>
              <div class="row two">
                <div>
                  <label for="quick_facts">Quick facts</label>
                  <textarea id="quick_facts" rows="3" placeholder="One per line. First 3 show on the card."></textarea>
                </div>
                <div>
                  <label for="why_bullets">Why this one</label>
                  <textarea id="why_bullets" rows="3" placeholder="One per line"></textarea>
                </div>
              </div>
              <div class="row two stack">
                <div><label for="headline">Headline</label><input id="headline" /></div>
                <div><label for="positioning_label">Positioning</label><input id="positioning_label" placeholder="Most popular" /></div>
              </div>
              <div class="stack">
                <label for="hero_description">Short description</label>
                <textarea id="hero_description" rows="2"></textarea>
              </div>
              <div class="stack">
                <label for="long_description">Long description</label>
                <textarea id="long_description" rows="4"></textarea>
              </div>
              <div class="row two stack">
                <div><label for="best_for">Best for</label><input id="best_for" /></div>
                <div><label for="ghl_tags">CRM tags</label><textarea id="ghl_tags" rows="2" placeholder="One per line"></textarea></div>
              </div>
            </fieldset>

            <div class="actions">
              <button class="primary" type="submit">Save product</button>
              <button class="ghost" type="button" id="resetForm">Clear</button>
            </div>
          </form>
        </div>
      </section>
    </main>

    {/* is:inline — plain browser JS, left untouched by the bundler. The
        admin panel is internal, so there is nothing to gain from bundling
        it, and inlining keeps this page free of build-time dependencies. */}
    <script is:inline>
      // sessionStorage keeps the token across refresh in this tab only.
      // Closing the tab still ends the session. Not localStorage: that
      // would survive the browser and stay readable by any later script.
      const TOKEN_KEY = 'inventory-admin-token';
      const STATUS_LABELS = {
        draft: 'Draft',
        available: 'Available',
        pending: 'Pending',
        sold: 'Sold',
        hidden: 'Hidden',
      };
      let token = '';
      try { token = sessionStorage.getItem(TOKEN_KEY) || ''; } catch { /* private mode */ }
      let categories = [];

      const $ = (id) => document.getElementById(id);
      const show = (el, on) => el.classList.toggle('hidden', !on);

      function setToken(value) {
        token = value;
        try {
          if (value) sessionStorage.setItem(TOKEN_KEY, value);
          else sessionStorage.removeItem(TOKEN_KEY);
        } catch { /* private mode */ }
      }

      function msg(target, text, kind) {
        target.innerHTML = text ? `<div class="msg ${kind}">${text}</div>` : '';
      }

      async function api(path, options = {}) {
        const res = await fetch(`/api/admin${path}`, {
          ...options,
          headers: {
            ...(options.body instanceof FormData ? {} : { 'Content-Type': 'application/json' }),
            ...(token ? { Authorization: `Bearer ${token}` } : {}),
            ...(options.headers || {}),
          },
        });
        let data = {};
        try { data = await res.json(); } catch { /* non-JSON */ }
        if (res.status === 401) { setToken(''); show($('login'), true); show($('panel'), false); show($('logout'), false); }
        return { status: res.status, data };
      }

      const lines = (v) => v.split('\n').map((s) => s.trim()).filter(Boolean);

      function resetEditor() {
        $('productForm').reset();
        $('formTitle').textContent = 'Add a product';
        msg($('formMsg'), '', '');
        renderGallery();
      }

      function showEditor() {
        $('formCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      /* ---------- login ---------- */
      $('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        msg($('loginMsg'), '', '');
        const { data } = await api('?action=login', {
          method: 'POST',
          body: JSON.stringify({ password: $('password').value }),
        });
        if (!data.ok) { msg($('loginMsg'), data.error || 'Sign in failed.', 'err'); return; }
        setToken(data.token);
        $('password').value = '';
        show($('login'), false); show($('panel'), true); show($('logout'), true);
        load();
      });

      $('logout').addEventListener('click', async () => {
        await api('?action=logout', { method: 'POST' });
        setToken('');
        show($('login'), true); show($('panel'), false); show($('logout'), false);
      });

      $('newProduct').addEventListener('click', () => {
        resetEditor();
        showEditor();
      });

      /* ---------- list ---------- */
      async function load() {
        const { data } = await api('');
        if (!data.ok) { msg($('globalMsg'), data.error || 'Could not load products.', 'err'); return; }
        categories = data.categories || [];

        if (data.imagesConfigured === false) {
          $('uploadHint').textContent =
            'Image hosting is not configured yet, so uploads will be refused. Paste an https:// URL instead.';
        }

        const orphans = data.products.filter((p) => p.orphaned);
        if (orphans.length) {
          $('orphanNotice').textContent =
            `${orphans.length} product${orphans.length === 1 ? ' sits' : 's sit'} in a category this site no longer sells. ` +
            `They are invisible to customers. Delete them, or turn the category back on in Launchpad → Configuration → Content.`;
        }
        show($('orphanNotice'), orphans.length > 0);

        const tbody = $('rows');
        if (!data.products.length) {
          tbody.innerHTML = '<tr><td class="empty" colspan="8">No products yet.</td></tr>';
          return;
        }

        tbody.innerHTML = '';
        for (const p of data.products) {
          const tr = document.createElement('tr');

          const photo = document.createElement('td');
          photo.className = 'photo';
          if (p.primary_image) {
            const img = document.createElement('img');
            img.src = p.primary_image;
            img.alt = '';
            photo.appendChild(img);
          } else {
            const empty = document.createElement('span');
            empty.className = 'photo-empty';
            photo.appendChild(empty);
          }

          const name = document.createElement('td');
          const title = document.createElement('div');
          title.className = 'name';
          title.textContent = p.inventory_name;
          name.appendChild(title);
          if (p.featured) {
            const flag = document.createElement('div');
            flag.className = 'meta good';
            flag.textContent = 'Featured';
            name.appendChild(flag);
          }
          if (p.orphaned) {
            const flag = document.createElement('div');
            flag.className = 'meta bad';
            flag.textContent = 'Not sold on this site';
            name.appendChild(flag);
          }

          const cat = document.createElement('td');
          cat.textContent = p.category;

          const status = document.createElement('td');
          status.className = 'status-cell';
          const sel = document.createElement('select');
          for (const s of ['draft', 'available', 'pending', 'sold', 'hidden']) {
            const o = document.createElement('option');
            o.value = s; o.textContent = STATUS_LABELS[s] || s; o.selected = p.status === s;
            sel.appendChild(o);
          }
          sel.addEventListener('change', async () => {
            const { data: r } = await api('', {
              method: 'PATCH',
              body: JSON.stringify({ slug: p.slug, status: sel.value }),
            });
            msg($('globalMsg'), r.ok ? `Updated ${p.inventory_name}.` : (r.error || 'Update failed.'), r.ok ? 'ok' : 'err');
            if (r.ok) load();
          });
          status.appendChild(sel);

          const price = document.createElement('td');
          price.textContent = p.price ? `$${p.price.toLocaleString()}` : '—';
          const monthly = document.createElement('td');
          monthly.textContent = p.monthly_payment ? `$${p.monthly_payment}/mo` : '—';
          const qty = document.createElement('td');
          qty.textContent = p.quantity;

          const act = document.createElement('td');
          const actions = document.createElement('div');
          actions.className = 'row-actions';
          const edit = document.createElement('button');
          edit.className = 'ghost btn-sm';
          edit.textContent = 'Edit';
          edit.addEventListener('click', () => fill(p));
          const del = document.createElement('button');
          del.className = 'danger btn-sm';
          del.textContent = 'Delete';
          del.addEventListener('click', async () => {
            if (!confirm(`Delete "${p.inventory_name}"? It is hidden, not erased.`)) return;
            const { data: r } = await api(`?slug=${encodeURIComponent(p.slug)}`, { method: 'DELETE' });
            msg($('globalMsg'), r.ok ? 'Deleted.' : (r.error || 'Delete failed.'), r.ok ? 'ok' : 'err');
            if (r.ok) load();
          });
          actions.append(edit, del);
          act.appendChild(actions);

          tr.append(photo, name, cat, status, price, monthly, qty, act);
          tbody.appendChild(tr);
        }
      }

      /* ---------- form ---------- */
      function fill(p) {
        $('formTitle').textContent = `Edit ${p.inventory_name}`;
        $('inventory_name').value = p.inventory_name || '';
        $('slug').value = p.slug || '';
        $('category').value = p.category || (categories[0] && categories[0].slug) || '';
        $('status').value = p.status || 'draft';
        $('quantity').value = p.quantity ?? 0;
        $('price').value = p.price || '';
        $('monthly_payment').value = p.monthly_payment || '';
        $('sort_order').value = p.sort_order ?? 0;
        $('primary_image').value = p.primary_image || '';
        $('gallery_images').value = (p.gallery_images || []).join('\n');
        $('featured').checked = Boolean(Number(p.featured));
        renderGallery();
        $('promo_label').value = p.promo_label || '';
        $('delivery_promise').value = p.delivery_promise || '';
        $('quick_facts').value = (p.quick_facts || []).join('\n');
        $('why_bullets').value = (p.why_bullets || []).join('\n');
        $('ghl_tags').value = (p.ghl_tags || []).join('\n');
        $('headline').value = p.headline || '';
        $('positioning_label').value = p.positioning_label || '';
        $('hero_description').value = p.hero_description || '';
        $('long_description').value = p.long_description || '';
        $('best_for').value = p.best_for || '';
        showEditor();
      }

      function galleryUrls() {
        return lines($('gallery_images').value);
      }

      function renderGallery() {
        const list = $('galleryList');
        list.innerHTML = '';
        for (const url of galleryUrls()) {
          const item = document.createElement('div');
          item.className = 'gallery-item';
          const img = document.createElement('img');
          img.src = url;
          img.alt = '';
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'danger';
          remove.textContent = 'Remove';
          remove.addEventListener('click', () => {
            $('gallery_images').value = galleryUrls().filter((item) => item !== url).join('\n');
            renderGallery();
          });
          item.append(img, remove);
          list.appendChild(item);
        }
      }

      async function uploadImage(file, onUrl) {
        msg($('formMsg'), 'Uploading…', 'ok');
        const fd = new FormData();
        fd.append('image', file);
        const { data } = await api('?action=upload', { method: 'POST', body: fd });
        if (!data.ok) { msg($('formMsg'), data.error || 'Upload failed.', 'err'); return; }
        onUrl(data.url);
        msg($('formMsg'), 'Uploaded.', 'ok');
      }

      $('resetForm').addEventListener('click', resetEditor);

      $('imageFile').addEventListener('change', async () => {
        const file = $('imageFile').files[0];
        if (!file) return;
        await uploadImage(file, (url) => { $('primary_image').value = url; });
        $('imageFile').value = '';
      });

      $('galleryFile').addEventListener('change', async () => {
        const file = $('galleryFile').files[0];
        if (!file) return;
        if (galleryUrls().length >= 20) {
          msg($('formMsg'), 'A product can have 20 gallery photos.', 'err');
          $('galleryFile').value = '';
          return;
        }
        await uploadImage(file, (url) => {
          $('gallery_images').value = [...galleryUrls(), url].join('\n');
          renderGallery();
        });
        $('galleryFile').value = '';
      });

      $('gallery_images').addEventListener('input', renderGallery);

      $('productForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          slug: $('slug').value,
          inventory_name: $('inventory_name').value,
          category: $('category').value,
          status: $('status').value,
          quantity: $('quantity').value,
          price: $('price').value,
          monthly_payment: $('monthly_payment').value,
          sort_order: $('sort_order').value,
          primary_image: $('primary_image').value,
          gallery_images: galleryUrls(),
          featured: $('featured').checked,
          promo_label: $('promo_label').value,
          delivery_promise: $('delivery_promise').value,
          quick_facts: lines($('quick_facts').value),
          why_bullets: lines($('why_bullets').value),
          ghl_tags: lines($('ghl_tags').value),
          headline: $('headline').value,
          positioning_label: $('positioning_label').value,
          hero_description: $('hero_description').value,
          long_description: $('long_description').value,
          best_for: $('best_for').value,
        };
        const { data } = await api('', { method: 'POST', body: JSON.stringify(payload) });
        if (!data.ok) { msg($('formMsg'), data.error || 'Save failed.', 'err'); return; }
        $('productForm').reset();
        $('formTitle').textContent = 'Add a product';
        renderGallery();
        msg($('formMsg'), 'Saved.', 'ok');
        load();
      });

      (async function boot() {
        const { data } = await api('?action=status');
        if (data && data.configured === false) {
          msg($('loginMsg'), data.error || 'Website admin password is not set. Add it in Launchpad → Integrations, then publish again.', 'err');
        }
        if (!token) return;
        show($('login'), false); show($('panel'), true); show($('logout'), true);
        load();
      })();
    </script>
  </body>
</html>
