---
/**
 * ADMIN PANEL — URL + server auth only. Never linked from a public page.
 *
 * Three things keep it that way, and none of them rely on remembering:
 *   - No component renders a link here. The Footer has no admin markup at
 *     all, and the nav is built from config, which has no admin entry.
 *   - astro.config excludes /admin from the sitemap.
 *   - public/_headers sends X-Robots-Tag noindex,nofollow and no-store for
 *     /admin/*, and robots.txt disallows it.
 *
 * The page itself is a shell. It renders NO product data server-side —
 * everything is fetched with a Bearer token after login, so an unauthorised
 * request gets an empty form, not a leaked inventory list.
 *
 * No React here on purpose. The customer-facing quiz is worth an island;
 * an internal CRUD panel is not worth shipping a framework for.
 */
import { site, enabledCategories } from '../../config';

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Inventory — {site.identity.name}</title>
    <link rel="icon" href={site.brand.logos.favicon} />
    <style is:global define:vars={{
      primary: site.brand.colors.primary,
      deep: site.brand.colors.deep,
      night: site.brand.colors.night,
      urgent: site.brand.colors.urgent,
      ink: site.brand.colors.ink,
      inkMuted: site.brand.colors.inkMuted,
    }}>
      :root { color-scheme: light; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { height: 100%; }
      body {
        font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
        background: #f4f5f7;
        color: var(--ink);
        line-height: 1.4;
      }
      button, input, select, textarea { font: inherit; }
      button { cursor: pointer; }
      .hidden { display: none !important; }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        height: 56px;
        padding: 0 20px;
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
      }
      .topbar strong { font-size: .95rem; color: var(--night); }
      .topbar span { color: var(--inkMuted); font-size: .8rem; }
      .linkish {
        background: none;
        border: 0;
        color: var(--inkMuted);
        font-size: .8rem;
        padding: 6px 0;
      }
      .linkish:hover { color: var(--night); }

      .login-screen {
        min-height: calc(100vh - 56px);
        display: grid;
        place-items: center;
        padding: 24px;
      }
      .login-card {
        width: min(100%, 360px);
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 28px 24px;
      }
      .login-card h1 { font-size: 1.2rem; color: var(--night); margin-bottom: 6px; }
      .login-card p { font-size: .85rem; color: var(--inkMuted); margin-bottom: 18px; }

      label { display: block; font-size: .78rem; font-weight: 600; color: #3f4b5f; margin: 0 0 6px; }
      input, select, textarea {
        width: 100%;
        padding: 9px 11px;
        border: 1px solid #d5dae3;
        border-radius: 8px;
        background: #fff;
        color: var(--ink);
      }
      input:focus, select:focus, textarea:focus {
        outline: 2px solid color-mix(in srgb, var(--primary) 35%, #93c5fd);
        outline-offset: 1px;
      }
      textarea { resize: vertical; min-height: 72px; }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 40px;
        padding: 8px 14px;
        border-radius: 8px;
        border: 1px solid transparent;
        font-weight: 600;
        font-size: .88rem;
      }
      .btn-primary { background: var(--night); color: #fff; }
      .btn-ghost { background: #fff; color: var(--deep); border-color: #d5dae3; }
      .btn-danger { background: #fff; color: var(--urgent); border-color: #f0c9c7; }
      .btn-wide { width: 100%; }
      .btn-sm { min-height: 32px; padding: 4px 10px; font-size: .78rem; }

      .workspace {
        height: calc(100vh - 56px);
        display: grid;
        grid-template-columns: 320px minmax(0, 1fr);
      }
      .list-pane, .edit-pane {
        min-width: 0;
        min-height: 0;
        display: flex;
        flex-direction: column;
        background: #fff;
      }
      .list-pane { border-right: 1px solid #e5e7eb; overflow: hidden; }
      .pane-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 14px 16px 10px;
      }
      .pane-head h2 { font-size: .95rem; color: var(--night); }
      .count { font-size: .75rem; color: var(--inkMuted); font-weight: 500; }
      .search-wrap { padding: 0 16px 12px; }
      #orphanNotice {
        margin: 0 16px 10px;
        padding: 8px 10px;
        border-radius: 8px;
        background: #fef4f3;
        color: #9a2b24;
        font-size: .78rem;
      }
      #units {
        overflow: auto;
        flex: 1;
        min-width: 0;
        padding: 0 8px 16px;
      }
      .unit {
        width: 100%;
        min-width: 0;
        display: grid;
        grid-template-columns: 48px minmax(0, 1fr) auto;
        gap: 10px;
        align-items: center;
        text-align: left;
        padding: 8px;
        border: 0;
        border-radius: 10px;
        background: transparent;
        color: inherit;
      }
      .unit:hover { background: #f4f6f8; }
      .unit.is-on { background: #eef3fb; }
      .unit-photo {
        width: 48px;
        height: 36px;
        min-width: 48px;
        max-width: 48px;
        border-radius: 6px;
        overflow: hidden;
        background: #eef1f5 center / cover no-repeat;
        border: 1px solid #e5e7eb;
      }
      .unit-copy { min-width: 0; }
      .unit-name { font-weight: 600; font-size: .86rem; color: var(--night); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .unit-meta { font-size: .72rem; color: var(--inkMuted); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .unit-price { font-size: .8rem; font-weight: 600; color: var(--night); white-space: nowrap; }
      .empty-list { padding: 28px 16px; color: var(--inkMuted); font-size: .86rem; }

      .edit-pane { background: #f4f5f7; }
      .edit-empty {
        flex: 1;
        display: grid;
        place-items: center;
        text-align: center;
        padding: 32px;
        color: var(--inkMuted);
      }
      .edit-empty strong { display: block; color: var(--night); font-size: 1rem; margin-bottom: 6px; }
      .editor { flex: 1; min-height: 0; display: flex; flex-direction: column; }
      .editor-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 20px 0;
      }
      .editor-head h2 { font-size: 1.05rem; color: var(--night); }
      .tabs {
        display: flex;
        gap: 4px;
        padding: 12px 20px 0;
        border-bottom: 1px solid #e5e7eb;
        background: #fff;
      }
      .tab {
        background: none;
        border: 0;
        border-bottom: 2px solid transparent;
        padding: 8px 10px;
        color: var(--inkMuted);
        font-weight: 600;
        font-size: .82rem;
      }
      .tab.is-on { color: var(--night); border-bottom-color: var(--night); }
      .editor-body {
        flex: 1;
        overflow: auto;
        padding: 18px 20px 20px;
        background: #fff;
      }
      .pane { display: none; }
      .pane.is-on { display: block; }
      .grid { display: grid; gap: 12px; }
      .two { grid-template-columns: 1fr; }
      .three { grid-template-columns: 1fr; }
      @media (min-width: 700px) {
        .two { grid-template-columns: 1fr 1fr; }
        .three { grid-template-columns: 1fr 1fr 1fr; }
      }
      .editor-foot {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 12px 20px;
        background: #fff;
        border-top: 1px solid #e5e7eb;
      }
      .hint { font-size: .75rem; color: var(--inkMuted); margin-top: 6px; }
      .msg { padding: 9px 12px; border-radius: 8px; font-size: .82rem; margin: 0 20px 0; }
      .msg.err { background: #fef4f3; color: #9a2b24; }
      .msg.ok { background: #eef8f1; color: #17643d; }
      .check-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 12px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #f8fafc;
      }
      .check-row input { width: auto; margin-top: 2px; }
      .check-row label { margin: 0; font-size: .86rem; font-weight: 500; }
      .gallery-list { display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); margin-top: 10px; }
      .gallery-item { position: relative; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; background: #f3f4f6; }
      .gallery-item img { display: block; width: 100%; max-width: 100%; height: 80px; object-fit: cover; }
      .gallery-item button { position: absolute; top: 6px; right: 6px; }
      .back { display: none; }
      @media (max-width: 899px) {
        .workspace { grid-template-columns: 1fr; height: auto; min-height: calc(100vh - 56px); }
        .list-pane { border-right: 0; min-height: calc(100vh - 56px); }
        .edit-pane { display: none; position: fixed; inset: 56px 0 0; z-index: 5; }
        .workspace.is-editing .list-pane { display: none; }
        .workspace.is-editing .edit-pane { display: flex; }
        .back { display: inline-flex; }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div>
        <strong>Inventory</strong>
        <span> · {site.identity.name}</span>
      </div>
      <button id="logout" class="linkish hidden" type="button">Sign out</button>
    </header>

    <section id="login" class="login-screen">
      <div class="login-card">
        <h1>Sign in</h1>
        <p>Enter the inventory password to manage units on the website.</p>
        <div id="loginMsg"></div>
        <form id="loginForm">
          <label for="password">Password</label>
          <input id="password" type="password" autocomplete="current-password" required />
          <div style="height:14px"></div>
          <button class="btn btn-primary btn-wide" type="submit">Sign in</button>
        </form>
      </div>
    </section>

    <section id="panel" class="workspace hidden">
      <aside class="list-pane">
        <div class="pane-head">
          <div>
            <h2>Units</h2>
            <div class="count" id="unitCount">Loading…</div>
          </div>
          <button type="button" class="btn btn-primary btn-sm" id="newProduct">Add</button>
        </div>
        <div class="search-wrap">
          <label class="hidden" for="unitSearch">Search</label>
          <input id="unitSearch" type="search" placeholder="Search units" />
        </div>
        <div id="orphanNotice" class="hidden"></div>
        <div id="globalMsg"></div>
        <div id="units"></div>
      </aside>

      <section class="edit-pane">
        <div id="editEmpty" class="edit-empty">
          <div>
            <strong>Select a unit</strong>
            <p>Choose one on the left, or add a new unit to the floor.</p>
            <div style="height:14px"></div>
            <button type="button" class="btn btn-primary" id="emptyAdd">Add unit</button>
          </div>
        </div>

        <div id="editor" class="editor hidden">
          <div class="editor-head">
            <div>
              <button type="button" class="linkish back" id="closeEditor">← Units</button>
              <h2 id="formTitle">New unit</h2>
            </div>
            <button type="button" class="btn btn-danger btn-sm hidden" id="deleteProduct">Delete</button>
          </div>
          <div class="tabs" role="tablist">
            <button type="button" class="tab is-on" data-tab="details">Details</button>
            <button type="button" class="tab" data-tab="photos">Photos</button>
            <button type="button" class="tab" data-tab="listing">Listing</button>
            <button type="button" class="tab" data-tab="copy">Copy</button>
          </div>
          <div id="formMsg"></div>
          <form id="productForm" class="editor">
            <div class="editor-body">
              <div class="pane is-on" data-pane="details">
                <div class="grid two">
                  <div>
                    <label for="inventory_name">Name</label>
                    <input id="inventory_name" required />
                  </div>
                  <div>
                    <label for="slug">URL slug</label>
                    <input id="slug" placeholder="Blank to generate from the name" />
                  </div>
                  <div>
                    <label for="category">Category</label>
                    <select id="category" required disabled={enabledCategories.length === 0}>
                      {enabledCategories.length === 0 ? (
                        <option value="">No categories enabled</option>
                      ) : (
                        enabledCategories.map((c) => <option value={c.slug}>{c.label}</option>)
                      )}
                    </select>
                  </div>
                  <div>
                    <label for="status">Status</label>
                    <select id="status">
                      <option value="draft">Draft (hidden)</option>
                      <option value="available">Available</option>
                      <option value="pending">Sale pending</option>
                      <option value="sold">Sold</option>
                      <option value="hidden">Hidden</option>
                    </select>
                  </div>
                  <div>
                    <label for="price">Cash price ($)</label>
                    <input id="price" type="number" min="0" />
                  </div>
                  <div>
                    <label for="monthly_payment">Monthly ($)</label>
                    <input id="monthly_payment" type="number" min="0" />
                  </div>
                  <div>
                    <label for="quantity">Quantity</label>
                    <input id="quantity" type="number" min="0" value="1" />
                  </div>
                  <div>
                    <label for="sort_order">Sort order</label>
                    <input id="sort_order" type="number" value="0" />
                  </div>
                </div>
              </div>

              <div class="pane" data-pane="photos">
                <div class="grid two">
                  <div>
                    <label for="imageFile">Main photo</label>
                    <input id="imageFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
                    <p class="hint" id="uploadHint">JPG, PNG, WEBP or GIF, up to 6 MB.</p>
                    <label for="primary_image">or photo URL</label>
                    <input id="primary_image" placeholder="https://…" />
                  </div>
                  <div>
                    <label for="galleryFile">Add gallery photo</label>
                    <input id="galleryFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
                    <p class="hint">Up to 20 extra views.</p>
                    <label for="gallery_images">or gallery URLs</label>
                    <textarea id="gallery_images" rows="3" placeholder="One URL per line"></textarea>
                  </div>
                </div>
                <div id="galleryList" class="gallery-list"></div>
              </div>

              <div class="pane" data-pane="listing">
                <div class="check-row">
                  <input id="featured" type="checkbox" />
                  <label for="featured">Featured on inventory pages</label>
                </div>
                <div class="grid two" style="margin-top:12px">
                  <div>
                    <label for="promo_label">Badge</label>
                    <input id="promo_label" placeholder="LAST ONE" />
                  </div>
                  <div>
                    <label for="delivery_promise">Delivery</label>
                    <input id="delivery_promise" placeholder="Delivery in 2 weeks" />
                  </div>
                  <div>
                    <label for="headline">Headline</label>
                    <input id="headline" />
                  </div>
                  <div>
                    <label for="positioning_label">Positioning</label>
                    <input id="positioning_label" placeholder="Most popular" />
                  </div>
                </div>
              </div>

              <div class="pane" data-pane="copy">
                <div class="grid two">
                  <div>
                    <label for="quick_facts">Quick facts</label>
                    <textarea id="quick_facts" rows="3" placeholder="One per line. First 3 show on the card."></textarea>
                  </div>
                  <div>
                    <label for="why_bullets">Why this one</label>
                    <textarea id="why_bullets" rows="3" placeholder="One per line"></textarea>
                  </div>
                </div>
                <div style="margin-top:12px">
                  <label for="hero_description">Short description</label>
                  <textarea id="hero_description" rows="2"></textarea>
                </div>
                <div style="margin-top:12px">
                  <label for="long_description">Long description</label>
                  <textarea id="long_description" rows="4"></textarea>
                </div>
                <div class="grid two" style="margin-top:12px">
                  <div>
                    <label for="best_for">Best for</label>
                    <input id="best_for" />
                  </div>
                  <div>
                    <label for="ghl_tags">CRM tags</label>
                    <textarea id="ghl_tags" rows="2" placeholder="One per line"></textarea>
                  </div>
                </div>
              </div>
            </div>
            <div class="editor-foot">
              <button class="btn btn-primary" type="submit">Save</button>
              <button class="btn btn-ghost" type="button" id="resetForm">Cancel</button>
            </div>
          </form>
        </div>
      </section>
    </section>

    <script is:inline>
      const TOKEN_KEY = 'inventory-admin-token';
      const STATUS_LABELS = {
        draft: 'Draft',
        available: 'Available',
        pending: 'Pending',
        sold: 'Sold',
        hidden: 'Hidden',
      };
      let token = '';
      try { token = sessionStorage.getItem(TOKEN_KEY) || ''; } catch { /* private mode */ }
      let categories = [];
      let products = [];
      let selectedSlug = '';
      let query = '';

      const $ = (id) => document.getElementById(id);
      const show = (el, on) => el.classList.toggle('hidden', !on);
      const lines = (v) => v.split('\n').map((s) => s.trim()).filter(Boolean);

      function setToken(value) {
        token = value;
        try {
          if (value) sessionStorage.setItem(TOKEN_KEY, value);
          else sessionStorage.removeItem(TOKEN_KEY);
        } catch { /* private mode */ }
      }

      function msg(target, text, kind) {
        target.innerHTML = text ? `<div class="msg ${kind}">${text}</div>` : '';
      }

      async function api(path, options = {}) {
        const res = await fetch(`/api/admin${path}`, {
          ...options,
          headers: {
            ...(options.body instanceof FormData ? {} : { 'Content-Type': 'application/json' }),
            ...(token ? { Authorization: `Bearer ${token}` } : {}),
            ...(options.headers || {}),
          },
        });
        let data = {};
        try { data = await res.json(); } catch { /* non-JSON */ }
        if (res.status === 401) {
          setToken('');
          show($('login'), true);
          show($('panel'), false);
          show($('logout'), false);
        }
        return { status: res.status, data };
      }

      function setTab(name) {
        document.querySelectorAll('.tab').forEach((tab) => tab.classList.toggle('is-on', tab.dataset.tab === name));
        document.querySelectorAll('.pane').forEach((pane) => pane.classList.toggle('is-on', pane.dataset.pane === name));
      }

      function openEditor() {
        show($('editEmpty'), false);
        show($('editor'), true);
        $('panel').classList.add('is-editing');
      }

      function closeEditor() {
        selectedSlug = '';
        $('productForm').reset();
        $('formTitle').textContent = 'New unit';
        show($('deleteProduct'), false);
        msg($('formMsg'), '', '');
        renderGallery();
        setTab('details');
        show($('editor'), false);
        show($('editEmpty'), true);
        $('panel').classList.remove('is-editing');
        renderList();
      }

      function startNew() {
        selectedSlug = '';
        $('productForm').reset();
        $('quantity').value = '1';
        $('sort_order').value = '0';
        $('formTitle').textContent = 'New unit';
        show($('deleteProduct'), false);
        msg($('formMsg'), '', '');
        renderGallery();
        setTab('details');
        openEditor();
        renderList();
        $('inventory_name').focus();
      }

      function fill(p) {
        selectedSlug = p.slug || '';
        $('formTitle').textContent = p.inventory_name || 'Edit unit';
        $('inventory_name').value = p.inventory_name || '';
        $('slug').value = p.slug || '';
        $('category').value = p.category || (categories[0] && categories[0].slug) || '';
        $('status').value = p.status || 'draft';
        $('quantity').value = p.quantity ?? 0;
        $('price').value = p.price || '';
        $('monthly_payment').value = p.monthly_payment || '';
        $('sort_order').value = p.sort_order ?? 0;
        $('primary_image').value = p.primary_image || '';
        $('gallery_images').value = (p.gallery_images || []).join('\n');
        $('featured').checked = Boolean(Number(p.featured));
        $('promo_label').value = p.promo_label || '';
        $('delivery_promise').value = p.delivery_promise || '';
        $('quick_facts').value = (p.quick_facts || []).join('\n');
        $('why_bullets').value = (p.why_bullets || []).join('\n');
        $('ghl_tags').value = (p.ghl_tags || []).join('\n');
        $('headline').value = p.headline || '';
        $('positioning_label').value = p.positioning_label || '';
        $('hero_description').value = p.hero_description || '';
        $('long_description').value = p.long_description || '';
        $('best_for').value = p.best_for || '';
        show($('deleteProduct'), Boolean(p.slug));
        renderGallery();
        setTab('details');
        msg($('formMsg'), '', '');
        openEditor();
        renderList();
      }

      function galleryUrls() {
        return lines($('gallery_images').value);
      }

      function renderGallery() {
        const list = $('galleryList');
        list.innerHTML = '';
        for (const url of galleryUrls()) {
          const item = document.createElement('div');
          item.className = 'gallery-item';
          const img = document.createElement('img');
          img.src = url;
          img.alt = '';
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'btn btn-danger btn-sm';
          remove.textContent = 'Remove';
          remove.addEventListener('click', () => {
            $('gallery_images').value = galleryUrls().filter((item) => item !== url).join('\n');
            renderGallery();
          });
          item.append(img, remove);
          list.appendChild(item);
        }
      }

      function renderList() {
        const box = $('units');
        const q = query.trim().toLowerCase();
        const visible = products.filter((p) => {
          if (!q) return true;
          return [p.inventory_name, p.slug, p.category, p.status].join(' ').toLowerCase().includes(q);
        });
        $('unitCount').textContent = `${products.length} on the floor`;
        box.innerHTML = '';
        if (!visible.length) {
          const empty = document.createElement('p');
          empty.className = 'empty-list';
          empty.textContent = products.length ? 'No units match that search.' : 'No units yet.';
          box.appendChild(empty);
          return;
        }
        for (const p of visible) {
          const row = document.createElement('button');
          row.type = 'button';
          row.className = 'unit' + (p.slug === selectedSlug ? ' is-on' : '');
          const photo = document.createElement('span');
          photo.className = 'unit-photo';
          photo.setAttribute('aria-hidden', 'true');
          photo.style.cssText = 'width:48px;height:36px;min-width:48px;max-width:48px;overflow:hidden;background:#eef1f5 center/cover no-repeat';
          if (p.primary_image) {
            photo.style.backgroundImage = `url(${JSON.stringify(p.primary_image)})`;
          }
          const mid = document.createElement('div');
          mid.className = 'unit-copy';
          const name = Object.assign(document.createElement('div'), { className: 'unit-name', textContent: p.inventory_name });
          const meta = Object.assign(document.createElement('div'), { className: 'unit-meta' });
          meta.textContent = [STATUS_LABELS[p.status] || p.status, p.category, p.featured ? 'Featured' : '']
            .filter(Boolean)
            .join(' · ');
          mid.append(name, meta);
          const price = Object.assign(document.createElement('div'), {
            className: 'unit-price',
            textContent: p.price ? `$${Number(p.price).toLocaleString()}` : '',
          });
          row.append(photo, mid, price);
          row.addEventListener('click', () => fill(p));
          box.appendChild(row);
        }
      }

      async function load() {
        const { data } = await api('');
        if (!data.ok) { msg($('globalMsg'), data.error || 'Could not load products.', 'err'); return; }
        categories = data.categories || [];
        products = data.products || [];
        if (data.imagesConfigured === false) {
          $('uploadHint').textContent = 'Uploads are off. Paste an https:// URL instead.';
        }
        const orphans = products.filter((p) => p.orphaned);
        $('orphanNotice').textContent = orphans.length
          ? `${orphans.length} unit${orphans.length === 1 ? '' : 's'} sit in a category this site no longer sells.`
          : '';
        show($('orphanNotice'), orphans.length > 0);
        renderList();
      }

      async function uploadImage(file, onUrl) {
        msg($('formMsg'), 'Uploading…', 'ok');
        const fd = new FormData();
        fd.append('image', file);
        const { data } = await api('?action=upload', { method: 'POST', body: fd });
        if (!data.ok) { msg($('formMsg'), data.error || 'Upload failed.', 'err'); return; }
        onUrl(data.url);
        msg($('formMsg'), 'Uploaded.', 'ok');
      }

      function signedIn() {
        show($('login'), false);
        show($('panel'), true);
        show($('logout'), true);
      }

      $('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        msg($('loginMsg'), '', '');
        const { data } = await api('?action=login', {
          method: 'POST',
          body: JSON.stringify({ password: $('password').value }),
        });
        if (!data.ok) { msg($('loginMsg'), data.error || 'Sign in failed.', 'err'); return; }
        setToken(data.token);
        $('password').value = '';
        signedIn();
        load();
      });

      $('logout').addEventListener('click', async () => {
        await api('?action=logout', { method: 'POST' });
        setToken('');
        show($('login'), true);
        show($('panel'), false);
        show($('logout'), false);
        closeEditor();
      });

      $('newProduct').addEventListener('click', startNew);
      $('emptyAdd').addEventListener('click', startNew);
      $('resetForm').addEventListener('click', closeEditor);
      $('closeEditor').addEventListener('click', closeEditor);
      $('unitSearch').addEventListener('input', () => {
        query = $('unitSearch').value;
        renderList();
      });
      document.querySelectorAll('.tab').forEach((tab) => {
        tab.addEventListener('click', () => setTab(tab.dataset.tab));
      });

      $('deleteProduct').addEventListener('click', async () => {
        const name = $('inventory_name').value || 'this unit';
        if (!selectedSlug || !confirm(`Delete "${name}"? It is hidden, not erased.`)) return;
        const { data } = await api(`?slug=${encodeURIComponent(selectedSlug)}`, { method: 'DELETE' });
        msg($('globalMsg'), data.ok ? 'Deleted.' : (data.error || 'Delete failed.'), data.ok ? 'ok' : 'err');
        if (data.ok) {
          closeEditor();
          load();
        }
      });

      $('imageFile').addEventListener('change', async () => {
        const file = $('imageFile').files[0];
        if (!file) return;
        await uploadImage(file, (url) => { $('primary_image').value = url; });
        $('imageFile').value = '';
      });

      $('galleryFile').addEventListener('change', async () => {
        const file = $('galleryFile').files[0];
        if (!file) return;
        if (galleryUrls().length >= 20) {
          msg($('formMsg'), 'A product can have 20 gallery photos.', 'err');
          $('galleryFile').value = '';
          return;
        }
        await uploadImage(file, (url) => {
          $('gallery_images').value = [...galleryUrls(), url].join('\n');
          renderGallery();
        });
        $('galleryFile').value = '';
      });

      $('gallery_images').addEventListener('input', renderGallery);

      $('productForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          slug: $('slug').value,
          inventory_name: $('inventory_name').value,
          category: $('category').value,
          status: $('status').value,
          quantity: $('quantity').value,
          price: $('price').value,
          monthly_payment: $('monthly_payment').value,
          sort_order: $('sort_order').value,
          primary_image: $('primary_image').value,
          gallery_images: galleryUrls(),
          featured: $('featured').checked,
          promo_label: $('promo_label').value,
          delivery_promise: $('delivery_promise').value,
          quick_facts: lines($('quick_facts').value),
          why_bullets: lines($('why_bullets').value),
          ghl_tags: lines($('ghl_tags').value),
          headline: $('headline').value,
          positioning_label: $('positioning_label').value,
          hero_description: $('hero_description').value,
          long_description: $('long_description').value,
          best_for: $('best_for').value,
        };
        const { data } = await api('', { method: 'POST', body: JSON.stringify(payload) });
        if (!data.ok) { msg($('formMsg'), data.error || 'Save failed.', 'err'); return; }
        selectedSlug = data.product?.slug || payload.slug;
        msg($('formMsg'), 'Saved.', 'ok');
        await load();
        const next = products.find((p) => p.slug === selectedSlug);
        if (next) fill(next);
      });

      (async function boot() {
        const { data } = await api('?action=status');
        if (data && data.configured === false) {
          msg($('loginMsg'), data.error || 'Inventory password is not set. Add it in Launchpad, then publish again.', 'err');
        }
        if (!token) return;
        signedIn();
        load();
      })();
    </script>
  </body>
</html>
